# ─────────────────────────────────────────────────────────────────
# Houdiny AI Demo — Environment Variables Template
# Copy this file to .env and fill in your actual values
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Claude API (Anthropic) ────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
CLAUDE_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# ── Resend (Email sending) ────────────────────────────────────────
# Get from: https://resend.com → API Keys (free tier available)
RESEND_API_KEY=re_your-key-here

# ── Gmail (Email sending via SMTP + reading replies via IMAP) ─────
# Your Gmail address
GMAIL_USER=your-email@gmail.com
# App Password (NOT your regular Gmail password)
# Get from: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Generate one for "Mail" + "Windows Computer" — looks like: abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=your-16-character-app-password-here
# The inbox where demo emails are delivered (can be same as GMAIL_USER)
TO_EMAIL=your-email@gmail.com

# ── Twilio (WhatsApp messaging) ───────────────────────────────────
# Get from: https://console.twilio.com → Account Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
# Twilio WhatsApp Sandbox number — found at:
# console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your own WhatsApp number (with country code) — must join sandbox first
YOUR_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# ── Ngrok (Public URL tunnel for WhatsApp webhooks) ───────────────
# Get from: https://ngrok.com → Sign up free → Your Authtoken
NGROK_AUTH_TOKEN=your-ngrok-token-here

# ── Calendly (Meeting booking link) ──────────────────────────────
# Your Calendly event link — get from: https://calendly.com
CALENDLY_LINK=https://calendly.com/your-username/30min

# ── AI Sender Identity (shown in emails and WhatsApp) ────────────
# Customize these to match who you want the AI to present as
SENDER_NAME=Jamie
SENDER_ROLE=Account Executive
SENDER_COMPANY=Houdiny AI
